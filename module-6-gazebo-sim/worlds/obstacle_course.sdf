<?xml version="1.0" ?>
<!--
  Obstacle course for the robot car.
  The robot starts at (0, 0) facing +x. The green goal pad is at (3, 0).
  Keep obstacles as boxes with no rotation: the agent reads their
  positions and sizes from this file to plan safe paths.
-->
<sdf version="1.8">
  <world name="obstacle_course">

    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Systems the world needs: physics, commands, scene updates, and sensors -->
    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="ignition-gazebo-imu-system"
            name="ignition::gazebo::systems::Imu"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.75 0.85 0.95 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===== Arena walls: x from -0.5 to 3.5 m, y from -1.25 to 1.25 m ===== -->
    <model name="wall_north">
      <static>true</static>
      <pose>1.5 1.25 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.05 0.05 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.05 0.05 0.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static>
      <pose>1.5 -1.25 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.05 0.05 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>4.05 0.05 0.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static>
      <pose>3.5 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 2.55 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 2.55 0.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static>
      <pose>-0.5 0 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.05 2.55 0.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.05 2.55 0.2</size></box></geometry>
          <material><ambient>0.4 0.4 0.4 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Obstacles ===== -->
    <model name="obstacle_red_box">
      <static>true</static>
      <pose>1.2 0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.3 0.3 0.25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.3 0.3 0.25</size></box></geometry>
          <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_blue_box">
      <static>true</static>
      <pose>2.2 0.9 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.3 0.25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.25</size></box></geometry>
          <material><ambient>0.1 0.2 0.8 1</ambient><diffuse>0.1 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="obstacle_orange_box">
      <static>true</static>
      <pose>2.2 -0.9 0.125 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.4 0.3 0.25</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.4 0.3 0.25</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===== Goal pad (flat marker the robot can drive onto) ===== -->
    <model name="goal_pad">
      <static>true</static>
      <pose>3.0 0 0.001 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.4 0.4 0.002</size></box></geometry>
          <material><ambient>0.1 0.7 0.2 1</ambient><diffuse>0.1 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
